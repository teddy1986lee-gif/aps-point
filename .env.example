# ───────── APS 포인트 교환 서버 설정 (복사해서 .env로 저장) ─────────
# 개발할 때는 .env 없이 npm start 하면 됩니다(문자는 콘솔 출력, 풀팟은 모의 풀팟).

# 운영 서버면 production. production에서는 아래 필수 값이 없으면 서버가 시작되지 않습니다.
NODE_ENV=production
PORT=3000

# [필수] 32자 이상 임의 문자열. 인증번호 보관용 해시에 씁니다.
# 만들기 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# DB 파일 위치(정기 백업 대상)
DB_PATH=./data/aps.db

# HTTPS 리버스 프록시(nginx, Caddy 등) 뒤에서 운영할 때
SECURE_COOKIES=1
TRUST_PROXY=1
HSTS=1

# 문자 발송: webhook(운영) | console(개발용, 운영에서는 시작 거부)
# webhook은 {"to","from","text"} JSON을 아래 주소로 POST 합니다.
SMS_PROVIDER=webhook
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# 사전 등록된 발신번호
SMS_SENDER=

# [필수] 풀팟 연동: http(운영) | mock(개발용 모의 풀팟, 운영에서는 시작 거부)
# 즉시 연결·즉시 지급에 쓰는 API 세 개의 규격은 README 4장을 보세요.
FULPOT_MODE=http
FULPOT_API_URL=
# 풀팟이 발급한 API 토큰(Authorization: Bearer 로 보냄)
FULPOT_API_TOKEN=
# 풀팟 응답을 기다리는 시간(밀리초). 넘으면 '결과 모름'으로 보고 지급 확인 대상으로 둡니다.
# FULPOT_TIMEOUT_MS=8000

# 문자 인증 제한(기본값 그대로 써도 됩니다)
# OTP_TTL_SEC=180
# OTP_RESEND_SEC=60
# OTP_MAX_ATTEMPTS=5
# OTP_MAX_PER_PHONE_HOUR=5
# OTP_MAX_PER_PHONE_DAY=10
# OTP_MAX_PER_IP_HOUR=30

# 로그인 유지 시간
# MEMBER_SESSION_HOURS=12
# ADMIN_SESSION_HOURS=12
# ADMIN_IDLE_MINUTES=120

# 개발용: 인증번호를 화면에 표시(NODE_ENV=production이면 무시)
# DEV_EXPOSE_OTP=1
# 개발용: 모의 풀팟의 지급 응답 바꾸기 ok | lost(지급됐지만 응답 없음) | down(요청 안 닿음) | reject
# FULPOT_MOCK_ISSUE=lost
